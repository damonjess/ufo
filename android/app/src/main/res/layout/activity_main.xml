<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/appRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp"
        android:paddingBottom="13dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/kickerDot"
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:background="@color/mint" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.22"
                android:text="@string/kicker"
                android:textAllCaps="true"
                android:textColor="@color/muted"
                android:textSize="9sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/brandTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="serif"
            android:includeFontPadding="false"
            android:letterSpacing="-0.025"
            android:text="@string/brand_plain"
            android:textColor="@color/text"
            android:textSize="34sp" />

        <TextView
            android:id="@+id/tagline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="2dp"
            android:text="@string/tagline"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/MonoLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stat_reports" />

                <TextView
                    android:id="@+id/statReports"
                    style="@style/StatValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="—" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/MonoLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stat_countries" />

                <TextView
                    android:id="@+id/statCountries"
                    style="@style/StatValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="—" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/MonoLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stat_years" />

                <TextView
                    android:id="@+id/statYears"
                    style="@style/StatValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="—" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/line" />

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/globeContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/bg2">

            <com.sightings.atlas.ui.GlobeView
                android:id="@+id/globe"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/globe_desc" />

            <TextView
                android:id="@+id/rotateHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_marginStart="14dp"
                android:layout_marginTop="12dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.18"
                android:text="@string/globe_hint"
                android:textAllCaps="true"
                android:textColor="@color/dim"
                android:textSize="8.5sp" />

            <TextView
                android:id="@+id/viewReadout"
                android:layout_width="190dp"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_marginStart="14dp"
                android:layout_marginTop="28dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.1"
                android:textColor="@color/mint"
                android:textSize="8sp" />

            <TextView
                android:id="@+id/plottedLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="14dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.18"
                android:textAllCaps="true"
                android:textColor="@color/muted"
                android:textSize="9sp" />

            <LinearLayout
                android:id="@+id/globeButtons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_marginTop="34dp"
                android:layout_marginEnd="14dp"
                android:gravity="end"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/autoSpin"
                        style="@style/CtrlPill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/auto_spin" />

                    <TextView
                        android:id="@+id/resetView"
                        style="@style/CtrlPill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="7dp"
                        android:text="@string/reset_view" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/nearMe"
                        style="@style/CtrlPill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="9dp"
                        android:paddingEnd="9dp"
                        android:text="@string/near_button"
                        android:textSize="8.5sp" />

                    <TextView
                        android:id="@+id/surprise"
                        style="@style/CtrlPill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:paddingStart="9dp"
                        android:paddingEnd="9dp"
                        android:text="@string/surprise"
                        android:textSize="8.5sp" />

                    <TextView
                        android:id="@+id/heatToggle"
                        style="@style/CtrlPill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:paddingStart="9dp"
                        android:paddingEnd="9dp"
                        android:text="@string/heat"
                        android:textSize="8.5sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/mapCredit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="14dp"
                android:layout_marginBottom="62dp"
                android:background="@drawable/bg_credit"
                android:fontFamily="monospace"
                android:letterSpacing="0.04"
                android:paddingStart="6dp"
                android:paddingTop="3dp"
                android:paddingEnd="6dp"
                android:paddingBottom="3dp"
                android:text="@string/map_credit"
                android:textColor="@color/muted"
                android:textSize="8sp"
                android:visibility="gone" />

            <HorizontalScrollView
                android:id="@+id/legendScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="66dp"
                android:layout_marginBottom="14dp"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/legend"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <LinearLayout
                android:id="@+id/zoomControls"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="14dp"
                android:layout_marginBottom="14dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/zoomIn"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_ctrl"
                    android:contentDescription="@string/zoom_in"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="@color/text"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/zoomOut"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_ctrl"
                    android:contentDescription="@string/zoom_out"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:text="−"
                    android:textColor="@color/text"
                    android:textSize="18sp" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/timelineBar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_timeline"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <TextView
                android:id="@+id/timelinePlay"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_ctrl"
                android:contentDescription="@string/timeline_play"
                android:fontFamily="monospace"
                android:gravity="center"
                android:text="▶"
                android:textColor="@color/text"
                android:textSize="12sp" />

            <com.sightings.atlas.ui.TimelineView
                android:id="@+id/timeline"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:contentDescription="@string/timeline_desc" />

            <TextView
                android:id="@+id/timelineYear"
                android:layout_width="78dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="monospace"
                android:gravity="center|end"
                android:letterSpacing="0.04"
                android:paddingStart="4dp"
                android:paddingEnd="2dp"
                android:text="@string/timeline_all"
                android:contentDescription="@string/timeline_all"
                android:textColor="@color/muted"
                android:textSize="9.5sp" />

            <TextView
                android:id="@+id/timelineSpeed"
                style="@style/CtrlPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:contentDescription="@string/timeline_speed_desc"
                android:gravity="center"
                android:minHeight="32dp"
                android:minWidth="40dp"
                android:paddingStart="9dp"
                android:paddingTop="5dp"
                android:paddingEnd="9dp"
                android:paddingBottom="5dp"
                android:text="@string/speed_1x"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/panel"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.35"
            android:background="@color/panel"
            android:orientation="vertical">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/line" />

            <LinearLayout
                android:id="@+id/tabs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bg_tabs"
                android:orientation="horizontal"
                android:padding="3dp">

                <TextView
                    android:id="@+id/tabReports"
                    style="@style/Tab"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/tabVideos"
                    style="@style/Tab"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/tabSocial"
                    style="@style/Tab"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_search"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="11dp"
                    android:paddingEnd="11dp">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_search" />

                    <EditText
                        android:id="@+id/searchInput"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="@string/search_hint"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:maxLines="1"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:singleLine="true"
                        android:textColor="@color/text"
                        android:textColorHint="@color/dim"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/filtersButton"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_field"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:letterSpacing="0.12"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:text="@string/filters"
                    android:textAllCaps="true"
                    android:textColor="@color/muted"
                    android:textSize="9.5sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingTop="11dp"
                android:paddingEnd="20dp"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/resultCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.14"
                    android:textAllCaps="true"
                    android:textColor="@color/muted"
                    android:textSize="9.5sp" />

                <TextView
                    android:id="@+id/onThisDay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:letterSpacing="0.1"
                    android:minHeight="36dp"
                    android:paddingStart="6dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="4dp"
                    android:text="@string/on_this_day"
                    android:textAllCaps="true"
                    android:textColor="@color/muted"
                    android:textSize="9.5sp" />

                <TextView
                    android:id="@+id/statsButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:background="?attr/selectableItemBackground"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:letterSpacing="0.1"
                    android:minHeight="36dp"
                    android:paddingStart="6dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="4dp"
                    android:text="@string/stats"
                    android:textAllCaps="true"
                    android:textColor="@color/muted"
                    android:textSize="9.5sp" />

                <TextView
                    android:id="@+id/clearFilters"
                    android:layout_marginStart="4dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:letterSpacing="0.1"
                    android:minHeight="36dp"
                    android:paddingStart="6dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="4dp"
                    android:text="@string/clear_filters"
                    android:textAllCaps="true"
                    android:textColor="@color/mint"
                    android:textSize="9.5sp"
                    android:visibility="gone" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="8dp"
                    android:scrollbars="none" />

                <TextView
                    android:id="@+id/emptyLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:padding="24dp"
                    android:text="@string/empty"
                    android:textColor="@color/muted"
                    android:textSize="12.5sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/loadingLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:letterSpacing="0.1"
                    android:text="@string/loading"
                    android:textColor="@color/dim"
                    android:textSize="11sp"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/moreButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_more"
                android:fontFamily="monospace"
                android:gravity="center"
                android:letterSpacing="0.12"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:text="@string/show_more"
                android:textAllCaps="true"
                android:textColor="@color/muted"
                android:textSize="9.5sp"
                android:visibility="gone" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/line" />

            <TextView
                android:id="@+id/source"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="2dp"
                android:paddingStart="20dp"
                android:paddingTop="10dp"
                android:paddingEnd="20dp"
                android:paddingBottom="12dp"
                android:textColor="@color/dim"
                android:textSize="9.5sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
